# CloudPulse backend configuration
# Copy this file to .env and adjust if your ports differ.

PROMETHEUS_URL=http://localhost:9090
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cloudpulse

API_HOST=0.0.0.0
API_PORT=5000

# Prometheus job name + disk volume to monitor (see monitoring/prometheus.yml)
PROM_JOB=windows
DISK_VOLUME=C:

# How often the collector samples Prometheus, in seconds
COLLECT_INTERVAL_SECONDS=10

# On first run, backfill this many minutes of REAL history from Prometheus
# so the ML models have data to work with immediately.
BACKFILL_MINUTES=120
